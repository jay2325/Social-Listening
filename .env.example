# Supabase — server-side (service role, never exposed to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — client-side (anon key only, for Realtime subscriptions)
# VITE_ prefix is required — Vite only exposes vars with this prefix to the browser.
# Enable the `mentions` table in Supabase → Database → Replication for live updates.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# X (Twitter) API — Bearer Token only for Phase 1
X_BEARER_TOKEN=your-bearer-token
X_API_KEY=your-api-key
X_API_SECRET=your-api-secret

# Redis — local Docker for dev, override with Upstash URL in prod
# Dev:  redis://localhost:6379
# Prod: rediss://default:<token>@<host>.upstash.io:6380
REDIS_URL=redis://localhost:6379

# NLP service
NLP_SERVICE_URL=http://localhost:8000

# Server
PORT=3001
NODE_ENV=development
